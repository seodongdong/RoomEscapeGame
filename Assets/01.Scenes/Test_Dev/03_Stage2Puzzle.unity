--- !u!114 &1807662194
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1807662193}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4071048cae9c164eaa3a5c32e8aeb3f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryClue
  clueId: stage2_diary
  clueName: "\uB0A1\uC740 \uC77C\uAE30\uC7A5"
  pages:
  - "1983\uB144 5\uC6D4 3\uC77C \uB0A0\uC528: \uB9D1\uC74C\r\n\r\n\uC624\uB298\uC740
    \uD559\uAD50\uB97C \uB610 \uC26C\uC5C8\uB2E4.\r\n\uBC30\uAC00 \uB108\uBB34 \uC544\uD30C\uC11C
    \uC5C4\uB9C8\uAC00 \uBCD1\uC6D0\uC5D0 \uB370\uB824\uAC14\uB2E4.\r\n\uC120\uC0DD\uB2D8\uC774
    \uC8FC\uC0AC\uB97C \uC138 \uAC1C\uB098 \uB1A8\uB294\uB370\r\n\uD558\uB098\uB3C4
    \uC548 \uC6B8\uC5C8\uB2E4. \uB098 \uC6A9\uAC10\uD558\uC9C0?\r\n\r\n\uBE68\uB9AC
    \uB098\uC544\uC11C \uC21C\uC774\uB791 \uC904\uB118\uAE30 \uD558\uACE0 \uC2F6\uB2E4.\r\n\uC21C\uC774\uAC00
    \uB0B4\uAC00 \uC5C6\uC73C\uBA74 \uC7AC\uBBF8\uC5C6\uB300\uC11C \uAE30\uBD84\uC774
    \uC88B\uC558\uB2E4.\r\n\r\n\uC544\uBE60\uAC00 \uC624\uB298 \uB0B4\uAC00 \uC88B\uC544\uD558\uB294
    \uB5A1\uBCF6\uC774 \uC0AC\uC654\uB2E4.\r\n\uADFC\uB370 \uBCC4\uB85C \uB9DB\uC774
    \uC5C6\uC5C8\uB2E4. \uC65C \uADF8\uB7F0\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
  - "1983\uB144 5\uC6D4 11\uC77C   \uB0A0\uC528: \uBAA8\uB984\r\n\r\n\uC694\uC998\uC740
    \uACC4\uC18D \uB204\uC6CC\uC788\uC5B4\uC57C \uD55C\uB2E4\uACE0 \uD55C\uB2E4.\r\n\uCC3D\uBB38\uC73C\uB85C
    \uBC16\uC774 \uBCF4\uC774\uB294\uB370\r\n\uC560\uB4E4\uC774 \uB6F0\uC5B4\uB178\uB294
    \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.\r\n\uB098\uB3C4 \uB098\uAC00\uACE0 \uC2F6\uC740\uB370.\r\n\r\n\uC5C4\uB9C8\uAC00
    \uC6B8\uC5C8\uB2E4.\r\n\uB098\uB294 \uC548 \uC544\uD508 \uCC99 \uD588\uB2E4.\r\n\uC5C4\uB9C8\uAC00
    \uC6B0\uB294 \uAC70 \uBCF4\uAE30 \uC2EB\uC73C\uB2C8\uAE4C.\r\n\r\n\uC544\uBE60\uAC00
    \uB098\uD55C\uD14C \uC77C\uAE30 \uC368\uBCF4\uB77C\uACE0 \uD588\uB2E4.\r\n\uC2EC\uC2EC\uD560
    \uB54C \uC4F0\uBA74 \uC88B\uB2E4\uACE0.\r\n\uC544\uBE60 \uB9D0\uC740 \uB2E4 \uB9DE\uC73C\uB2C8\uAE4C
    \uC368\uBD24\uB2E4.\r\n\r\n\uBE68\uB9AC \uB098\uC544\uC57C\uC9C0.\r\n\uC18C\uD48D\uC774
    \uC774\uBC88 \uB2EC\uC778\uB370."
  - "1983\uB144 5\uC6D4 ??\uC77C\r\n\r\n\uC624\uB298\uC774 \uBA70\uCE60\uC778\uC9C0
    \uBAA8\uB974\uACA0\uB2E4.\r\n\r\n\uADF8\uB0E5 \uC790\uAFB8 \uC7A0\uC774 \uC628\uB2E4.\r\n\r\n\uC544\uBE60\uAC00
    \uC606\uC5D0 \uC788\uC5B4\uC92C\uB2E4."
  - "[\uC5BC\uB8E9]\n\n\n\n\uD398\uC774\uC9C0 \uC804\uCCB4\uAC00 \uB208\uBB3C\uC5D0
    \uC816\uC5B4 \uAE00\uC528\uAC00 \uBC88\uC838\uC788\uB2E4. \uC54C\uC544\uBCFC
    \uC218 \uC5C6\uB2E4."
  - "[\uC5BC\uB8E9]\r\n\r\n\r\n                  [\uC5BC\uB8E9]\r\n\r\n\r\n    [\uC5BC\uB8E9]\n\n\n\n\uC544\uBB34\uAC83\uB3C4
    \uC801\uD600\uC788\uC9C0 \uC54A\uB2E4. \uBE57\uBB3C\uCC98\uB7FC \uB465\uAE00\uAC8C
    \uBC88\uC9C4 \uC790\uAD6D\uB9CC \uC5EC\uB7EC \uAC1C \uB0A8\uC544\uC788\uB2E4."
  - "[\uC5BC\uB8E9]     [\uC5BC\uB8E9]\r\n\r\n\r\n      [\uC5BC\uB8E9]          
    [\uC5BC\uB8E9]\r\n\r\n           [\uC5BC\uB8E9]\n\n\n\n\uB208\uBB3C \uC790\uAD6D\uC774
    \uBE7D\uBE7D\uD558\uB2E4. \uADF8 \uC0AC\uC774\uB85C \uD750\uB9BF\uD558\uAC8C
    \uD55C \uAE00\uC790\uB9CC \uBCF4\uC778\uB2E4.\n'\uC544'"
  itemDate: 1983.05
  summary: "\uB0A1\uC740 \uC77C\uAE30\uC7A5\uC774\uB2E4... \uB118\uACA8\uBD10\uB3C4
    \uB418\uB098."
  speaker: "\uC18C\uB144"
  firstDialogue: "\uCC22\uC5B4\uC9C4 \uC77C\uAE30\uC7A5\uC774\uB2E4... \uB204\uAC00
    \uADF8\uB9B0 \uAC78\uAE4C?"
  collectOnRead: 1
