  clueName: "\uCC22\uC5B4\uC9C4 \uC77C\uAE30\uC7A5"
  pages:
  - "2023\uB144 7\uC6D4 15\uC77C\n\n\uC624\uB298\uC740 \uCE5C\uAD6C\uAC00 \uC6B0\uB9AC\uC9D1\uC5D0
